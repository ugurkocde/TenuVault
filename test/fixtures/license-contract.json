{
  "description": "Licensing contract between the TenuVault desktop app and the licensing service at /api/desktop-license. Keep byte-identical in both repositories. Add-only: never remove or rename a reason, field or token version. trial_used is a tenant-specific key activation refusal: keep the saved key, do not trigger Community fallback, and leave other tenants and valid coverage untouched, just as for invalid_key. Its message is: This tenant already had a Pro trial. Buy Pro to continue, or write to support@tenuvault.com. The service sends trial_used only at or above its configured minimum app version (default 0.5.0, prerelease at that core excluded); older, missing or malformed versions receive invalid_key.",
  "installId": "0f9e8d7c-6b5a-4c3d-8e2f-1a0b9c8d7e6f",
  "tenantId": "11111111-2222-4333-8444-555555555555",
  "publicKey": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAbwok6RINBZiJXvPclucgwuw+PmEe6km0g4c6DtPGkFI=\n-----END PUBLIC KEY-----\n",
  "refusalReasons": [
    "invalid_key",
    "not_found",
    "revoked",
    "disabled",
    "expired",
    "tenant_limit",
    "install_limit",
    "activation_limit",
    "activation_mismatch",
    "tenant_not_licensed",
    "trial_used"
  ],
  "otherReasons": {
    "400": [
      "bad_request"
    ],
    "401": [
      "invalid_token"
    ],
    "429": [
      "rate_limited"
    ],
    "502": [
      "upstream"
    ],
    "503": [
      "unavailable",
      "tenant_quantity_unknown",
      "storage_unavailable"
    ]
  },
  "tenantTrial": {
    "endpoint": "POST /api/desktop-license/tenant",
    "commonRequest": {
      "idToken": "verified Microsoft ID token, tenant from tid",
      "installId": "UUID",
      "os": "win32 | darwin | linux",
      "appVersion": "semver"
    },
    "actions": {
      "start_trial": {
        "optional": {
          "source": "auto | opt-in (default auto)"
        },
        "response": "trialEntitlement"
      },
      "refresh": {
        "required": {
          "activationId": "trial- followed by 32 lowercase hex characters"
        },
        "response": "trialEntitlement"
      },
      "extend_trial": {
        "required": {
          "activationId": "trial activation ID"
        },
        "response": "trialEntitlement",
        "window": "inclusive: ends_at minus 5 days through ends_at plus 14 days; once only; new end is greatest(ends_at, request time) plus 14 days"
      },
      "end_trial": {
        "missingTrial": "Returns success true when the tenant has no trial row; activationId must still match the tenant and install.",
        "required": {
          "activationId": "trial activation ID"
        },
        "response": {
          "success": true
        },
        "authorization": "Only the starting install; another install receives 403 trial_unavailable with reason not_starter"
      },
      "trial_contact": {
        "required": {
          "activationId": "trial activation ID"
        },
        "optional": {
          "email": "trimmed valid email, maximum 254 characters"
        },
        "response": {
          "success": true
        },
        "contact": "One contact per tenant in desktop_tenant_trial_contacts. Email upserts and replaces the address. Reminder timestamps and unsubscribed_at are cleared only when the address changes. Omitted email deletes the contact."
      }
    },
    "responses": {
      "trialEntitlement": {
        "token": "signed v2 entitlement",
        "activationId": "trial-<first 32 hex chars HMAC(lowercase tenantId + lowercase installId)>",
        "plan": "pro",
        "tenants": 2,
        "expiresAt": "ISO 8601 token expiry",
        "source": "trial",
        "trial": true,
        "keyExp": "Unix seconds, trial end",
        "canEnd": "boolean, true only for the install that started the trial"
      },
      "unavailable": {
        "status": 403,
        "error": "trial_unavailable",
        "reason": [
          "used",
          "licensed",
          "install_limit",
          "disabled",
          "app_update_required",
          "not_starter"
        ]
      },
      "expired": {
        "status": 403,
        "error": "The license was not accepted.",
        "reason": "expired"
      }
    },
    "otherErrors": "Existing key and organization actions keep their responses. Trial actions: failed reads and mutations return 503 storage_unavailable. Missing store or invalid/missing pepper: start_trial returns 403 trial_unavailable with reason disabled; other trial actions return 503 storage_unavailable. Incorrect activation returns 403 activation_mismatch.",
    "extensionAtUpperBoundary": "At exactly ends_at + 14 days an eligible extension succeeds, with a new end 14 days after the request time.",
    "payload": {
      "v": 2,
      "sub": "trial:<first 16 hex chars tenant hash>",
      "act": "trial activation ID",
      "plan": "pro",
      "tenants": 2,
      "trial": true,
      "keyExp": "trial end in Unix seconds",
      "tenantId": "verified tid lowercase",
      "installId": "request installId lowercase",
      "iat": "Unix seconds",
      "exp": "min(iat + 14 days, keyExp)",
      "status": "granted"
    },
    "conversion": "converted_at is reporting only; running trials remain joinable and refreshable. Converted trials cannot extend. An organization mapping, including a stale mapping, refuses start_trial with licensed but does not stop an existing trial refresh."
  },
  "tokenVersions": [
    1,
    2
  ],
