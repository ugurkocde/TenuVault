---
// Page title with the frontmatter description as a muted subtitle directly under it.
// The id must stay "_top": Starlight's skip link and table of contents point at it.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="page-description">{description}</p>}

<style>
	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
		line-height: 1.05;
		font-weight: 400;
		letter-spacing: -0.04em;
		color: var(--sl-color-white);
		text-wrap: pretty;
	}
	.page-description {
		margin-top: 1rem;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--sl-color-gray-3);
		text-wrap: pretty;
	}
	@media (max-width: 49.99rem) {
		.page-description {
			font-size: 1.0625rem;
		}
	}
</style>
