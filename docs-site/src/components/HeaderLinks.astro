---
// Header links in a gray pill (Pricing, Changelog, GitHub), then Download as the black primary pill.
// Starlight also renders this component in the mobile menu footer.
// Download opens a small menu with the Windows and macOS installers. The links go to the website's
// /download/<platform> routes, which redirect to the newest stable installer (so the download starts
// right away) and record "Download started" in Plausible. The click itself is recorded here as
// "Download click" with the same props the website uses, placement docs-header.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const download = (platform: string) => `https://www.tenuvault.com/download/${platform}`;
// The component renders twice (header and mobile menu footer), so each menu needs its own id.
const menuId = `tv-download-${Math.random().toString(36).slice(2, 8)}`;
---

<nav class="header-pill" aria-label="Product">
	<a class="header-link" href="https://tenuvault.com/pricing">Pricing</a>
	<a class="header-link" href="https://github.com/ugurkocde/TenuVault/releases">Changelog</a>
	<Default />
</nav>
<tv-download-menu class="download-menu">
	<button class="header-cta" type="button" popovertarget={menuId}>Download</button>
	<div class="download-panel" id={menuId} popover>
		<p class="download-title">Download TenuVault</p>
		<a class="download-option" href={download('windows')} data-platform="windows">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5 10.5 4.5v7H3zM11.5 4.4 21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.4z" /></svg>
			<span>Windows</span>
		</a>
		<a class="download-option" href={download('mac-arm64')} data-platform="mac-arm64" data-mac>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.1-1.2 2.9-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.4-1-2.4-3.9zM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1 .1 2.1-.6 2.8-1.4z" /></svg>
			<span>macOS</span>
		</a>
		<p class="download-note">
			<a href="https://www.tenuvault.com/download">Intel Mac, MSI and other installers</a>
		</p>
	</div>
</tv-download-menu>

<script>
	type Plausible = (name: string, options: { props: Record<string, string> }) => void;

	// Chromium browsers report the real CPU architecture; Safari and Firefox do not, and keep the
	// Apple silicon build, which is what nearly every current Mac needs.
	async function macBuild(): Promise<'mac-arm64' | 'mac-x64' | null> {
		const hints = (navigator as Navigator & {
			userAgentData?: { getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }> };
		}).userAgentData;
		// Only a Mac's own architecture says which Mac build it needs.
		if (!/^mac/i.test(navigator.platform) || !hints?.getHighEntropyValues) return null;
		try {
			const { architecture } = await hints.getHighEntropyValues(['architecture']);
			return architecture === 'arm' ? 'mac-arm64' : architecture === 'x86' ? 'mac-x64' : null;
		} catch {
			return null;
		}
	}

	// The panel is a native popover nested in the page (or in Starlight's mobile menu popover), so the
	// browser handles Escape and clicks outside, closing only the topmost layer. Opened panels sit in
	// the top layer, so they are placed next to the button here: below it, or above it when the button
	// is low on the screen (the mobile menu footer).
	class DownloadMenu extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const panel = this.querySelector<HTMLElement>('.download-panel')!;
			const place = () => {
				const rect = button.getBoundingClientRect();
				const gap = 8;
				const below = rect.bottom + gap + panel.offsetHeight <= window.innerHeight;
				panel.style.top = below ? `${rect.bottom + gap}px` : `${Math.max(gap, rect.top - gap - panel.offsetHeight)}px`;
				panel.style.left = `${Math.max(gap, rect.right - panel.offsetWidth)}px`;
			};
			panel.addEventListener('toggle', (event) => {
				const open = (event as ToggleEvent).newState === 'open';
				button.setAttribute('aria-expanded', String(open));
				if (open) place();
			});
			button.setAttribute('aria-expanded', 'false');
			window.addEventListener('resize', () => panel.hidePopover?.());

			const mac = panel.querySelector<HTMLAnchorElement>('[data-mac]')!;
			macBuild().then((build) => {
				if (!build) return;
				mac.href = mac.href.replace(/mac-(arm64|x64)$/, build);
				mac.dataset.platform = build;
			});

			for (const link of panel.querySelectorAll<HTMLAnchorElement>('.download-option')) {
				link.addEventListener('click', () => {
					// Analytics is optional and must never block the download.
					try {
						(window as Window & { plausible?: Plausible }).plausible?.('Download click', {
							props: { platform: link.dataset.platform!, placement: 'docs-header' },
						});
					} catch {
						/* Continue the download. */
					}
					panel.hidePopover?.();
				});
			}
		}
	}

	if (!customElements.get('tv-download-menu')) customElements.define('tv-download-menu', DownloadMenu);
</script>

<style>
	.header-pill {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.3125rem;
		border-radius: 999px;
		background-color: var(--tv-surface);
	}
	.header-link,
	.header-pill :global(a.sl-flex) {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		padding-inline: 0.875rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 400;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 150ms ease,
			color 150ms ease;
	}
	.header-pill :global(a.sl-flex) {
		padding-inline: 0.625rem;
	}
	.header-link:hover,
	.header-pill :global(a.sl-flex:hover) {
		background-color: var(--tv-pill-hover);
		color: var(--sl-color-white);
	}
	.download-menu {
		position: relative;
		display: inline-flex;
	}
	.header-cta {
		display: inline-flex;
		align-items: center;
		height: 2.5rem;
		padding-inline: 1.125rem;
		border: 0;
		border-radius: 999px;
		background-color: var(--tv-ink-button);
		color: var(--tv-ink-button-text);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 150ms ease,
			transform 150ms ease;
	}
	.header-cta:hover,
	.header-cta[aria-expanded='true'] {
		background-color: var(--tv-ink-button-hover);
		transform: translateY(-1px);
	}
	.header-cta:focus-visible,
	.download-option:focus-visible,
	.download-note a:focus-visible {
		outline: 2px solid var(--tv-focus);
		outline-offset: 2px;
	}
	.download-panel {
		position: fixed;
		inset: auto;
		margin: 0;
		width: 15.5rem;
		padding: 0.75rem;
		border: 1px solid var(--tv-line);
		border-radius: 1rem;
		background-color: var(--sl-color-black);
		color: var(--sl-color-text);
		box-shadow: var(--sl-shadow-lg);
	}
	.download-title {
		margin: 0 0 0.5rem;
		padding-inline: 0.25rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.download-option {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		height: 2.75rem;
		margin-top: 0.375rem;
		padding-inline: 1rem;
		border-radius: 999px;
		background-color: var(--tv-ink-button);
		color: var(--tv-ink-button-text);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		transition: background-color 150ms ease;
	}
	.download-option:hover {
		background-color: var(--tv-ink-button-hover);
		color: var(--tv-ink-button-text);
	}
	.download-option svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: currentColor;
		flex: none;
	}
	.download-note {
		margin: 0.75rem 0 0;
		padding-inline: 0.25rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	.download-note a {
		color: var(--sl-color-gray-2);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.download-note a:hover {
		color: var(--sl-color-white);
	}
</style>
