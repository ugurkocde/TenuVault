---
// Logo and product name link to the marketing site; the muted "Docs" label links to the docs home.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
const hasThemedLogos = config.logo && !('src' in config.logo);
---

<div class="site-title sl-flex">
	<a href="https://tenuvault.com/" class="site-title-brand sl-flex" aria-label="TenuVault home">
		{
			logos.dark && (
				<img
					class:list={{ 'light:sl-hidden print:hidden': hasThemedLogos }}
					alt=""
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
			)
		}
		{
			hasThemedLogos && logos.light && (
				<img
					class="dark:sl-hidden print:block"
					alt=""
					src={logos.light.src}
					width={logos.light.width}
					height={logos.light.height}
				/>
			)
		}
		<span class="site-title-name" translate="no">TenuVault</span>
	</a>
	<a href={siteTitleHref} class="site-title-tag" aria-label="TenuVault Docs home">Docs</a>
</div>

<style>
	.site-title {
		align-items: center;
		gap: 0.25rem;
		white-space: nowrap;
		min-width: 0;
	}
	.site-title a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.site-title-brand {
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
	}
	img {
		height: 2rem;
		width: auto;
	}
	.site-title-name {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	/* Padded into a pill sized tap target so it is easy to hit next to the logo on a phone. */
	.site-title .site-title-tag {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding-inline: 0.375rem;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		transition: color 150ms ease;
	}
	.site-title .site-title-tag:hover {
		color: var(--sl-color-white);
	}
</style>
