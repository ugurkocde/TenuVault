      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/get-started/getting-started",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/security/security",
      "destination": "/security/",
      "permanent": true
    },
    {
      "source": "/use-tenuvault",
      "destination": "/tenants/",
      "permanent": true
