{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../resources/New-TenuVaultDesktopApp.ps1 2>/dev/null && exit 0 || exit 1",
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/getting-started/",
      "permanent": true
    },
    {
      "source": "/readme",
