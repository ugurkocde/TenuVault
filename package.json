{
  "name": "tenuvault-desktop",
  "productName": "TenuVault",
  "version": "0.3.0",
  "private": true,
  "description": "TenuVault Desktop: Intune backup, restore and drift detection that runs entirely on your machine.",
  "author": "Ugur Koc",
  "homepage": "https://github.com/ugurkocde/TenuVault",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "node scripts/install-electron.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "license:keypair": "node scripts/generate-license-keypair.mjs",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "vitest run --mode e2e",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.514.0",
    "oxlint": "1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ugurkocde/TenuVault.git"
  },
  "license": "BUSL-1.1",
  "allowScripts": {
    "core-js": false,
    "electron-winstaller": false,
    "esbuild": false,
    "fsevents": false
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "http-cache-semantics": "^4.2.1",
    "source-map-js": "^1.2.2"
  }
}
