{
  "name": "tenuvault-desktop",
  "productName": "TenuVault",
  "version": "0.2.0",
  "private": true,
  "description": "TenuVault Desktop: Intune backup, restore and drift detection that runs entirely on your machine.",
  "author": "Ugur Koc",
  "homepage": "https://github.com/ugurkocde/TenuVault",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "license:keypair": "node scripts/generate-license-keypair.mjs",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "vitest run --mode e2e",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/react-query": "^5.84.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.514.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ugurkocde/TenuVault.git"
  },
  "license": "BUSL-1.1"
}
