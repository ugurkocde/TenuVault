{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploys the TenuVault cloud backup runner into your own subscription: an Azure Automation account with a managed identity, the Invoke-TenuVaultBackup runbook, a Key Vault for the backup recovery key, the container scoped backup writer role, and one tenant schedule. The template cannot grant Microsoft Graph application roles (no ARM resource can): a Global Administrator assigns the five read-only DeviceManagement roles listed in the deployment outputs to the managed identity, or runs New-TenuVaultCloudBackup.ps1 with -GrantGraphRoles instead. The setup script is the fuller path (it also creates the failure alert and computes the first schedule occurrence); this template is the portal friendly bootstrap that produces the same resources.",
    "author": "Ugur Koc"
  },
  "parameters": {
    "tenantId": {
      "type": "string",
      "metadata": { "description": "Entra tenant (directory) id GUID whose Intune configuration is backed up." }
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": { "description": "Existing storage account that holds the intune-backups container, the same account the tenant uses in TenuVault. Deploy this template into that storage account's resource group (New-TenuVaultStorage.ps1 uses rg-tenuvault-backups). For a storage account in another resource group, use New-TenuVaultCloudBackup.ps1 instead." }
    },
    "recoveryKey": {
      "type": "securestring",
      "metadata": { "description": "The tenant's TenuVault backup recovery key (TVK2 bundle from the desktop app, Settings > Storage and recovery > Save recovery key). Stored as a Key Vault secret. Anyone who can read it can read every backup." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Region for the Automation account and Key Vault." }
    },
    "automationAccountName": {
      "type": "string",
      "defaultValue": "aa-tenuvault",
      "metadata": { "description": "Automation account name. One account serves the one Entra tenant its managed identity belongs to." }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[concat('kv-tenuvault-', take(uniqueString(resourceGroup().id), 6))]",
      "metadata": { "description": "Key Vault name (globally unique, 3 to 24 characters)." }
    },
    "scope": {
      "type": "string",
      "allowedValues": ["everything", "policies"],
      "defaultValue": "policies",
      "metadata": { "description": "What cloud backups cover. policies is everything except apps, the desktop default." }
    },
    "excludedFolders": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Comma separated type folders to leave out. Wins over the scope. Leave empty for the scope." }
    },
    "includeDeviceCategories": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Set true only when the tenant decided to grant DeviceManagementManagedDevices.Read.All (it also exposes the device inventory). Otherwise cloud backups leave out DeviceCategories and DeviceCleanupRules." }
    },
    "frequency": {
      "type": "string",
      "allowedValues": ["Day", "Week"],
      "defaultValue": "Day",
      "metadata": { "description": "Schedule frequency." }
    },
    "weekDay": {
      "type": "string",
      "allowedValues": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "defaultValue": "Sunday",
      "metadata": { "description": "Day of the week, for a weekly schedule." }
    },
    "scheduleStartTime": {
      "type": "string",
      "metadata": { "description": "First run, as an ISO 8601 date time with offset, at least 5 minutes in the future, for example 2026-11-01T02:00:00+01:00. Its time of day becomes the recurring backup time." }
    },
    "timeZone": {
      "type": "string",
      "defaultValue": "UTC",
      "metadata": { "description": "IANA timezone for the schedule, for example Europe/Berlin. Daylight saving follows the timezone." }
    },
    "runbookUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/ugurkocde/TenuVault/main/resources/runbooks/Invoke-TenuVaultBackup.ps1",
      "metadata": { "description": "Where the published runbook is loaded from. Pin a release tag or your own copy if you prefer." }
    }
  },
  "variables": {
    "tenantKey": "[take(toLower(parameters('tenantId')), 8)]",
    "runbookName": "Invoke-TenuVaultBackup",
    "scheduleName": "[concat('TenuVaultBackup-', variables('tenantKey'))]",
    "container": "intune-backups",
    "secretName": "tenuvault-recovery-key",
    "storageAccountIdForName": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "containerScope": "[concat('subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Storage/storageAccounts/', parameters('storageAccountName'), '/blobServices/default/containers/', variables('container'))]",
    "appOnlyExcluded": "[if(parameters('includeDeviceCategories'), '', 'DeviceCategories,DeviceCleanupRules')]",
    "variableValues": [
      { "name": "[concat('TenuVaultTenantId-', variables('tenantKey'))]", "value": "[parameters('tenantId')]" },
      { "name": "[concat('TenuVaultStorageAccount-', variables('tenantKey'))]", "value": "[parameters('storageAccountName')]" },
      { "name": "[concat('TenuVaultKeyVault-', variables('tenantKey'))]", "value": "[parameters('keyVaultName')]" },
      { "name": "[concat('TenuVaultScope-', variables('tenantKey'))]", "value": "[parameters('scope')]" },
      { "name": "[concat('TenuVaultExcludedFolders-', variables('tenantKey'))]", "value": "[parameters('excludedFolders')]" },
      { "name": "[concat('TenuVaultAppOnlyExcluded-', variables('tenantKey'))]", "value": "[variables('appOnlyExcluded')]" }
    ],
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "writerRoleName": "TenuVault Backup Writer"
  },
  "resources": [
    {
      "type": "Microsoft.Automation/automationAccounts",
      "apiVersion": "2023-11-01",
      "name": "[parameters('automationAccountName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "sku": { "name": "Basic" },
        "disableLocalAuth": true,
        "publicNetworkAccess": true
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 30,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(parameters('keyVaultName'), '/', variables('secretName'))]",
      "dependsOn": ["[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"],
      "properties": { "value": "[parameters('recoveryKey')]" }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('automationAccountName'), variables('keyVaultSecretsUserRoleId'))]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', parameters('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName')), '2023-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('writerRoleName'), resourceGroup().id)]",
      "properties": {
        "roleName": "[variables('writerRoleName')]",
        "description": "TenuVault Backup Writer: writes backups. Cannot delete blobs, blob versions or containers.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": [],
            "notActions": [],
            "dataActions": [
              "Microsoft.Storage/storageAccounts/blobServices/containers/blobs/read",
              "Microsoft.Storage/storageAccounts/blobServices/containers/blobs/write",
              "Microsoft.Storage/storageAccounts/blobServices/containers/blobs/add/action"
            ],
            "notDataActions": []
          }
        ],
        "assignableScopes": ["[resourceGroup().id]"]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('containerScope'), parameters('automationAccountName'), variables('writerRoleName'))]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageAccountName'), '/blobServices/default/containers/', variables('container'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Authorization/roleDefinitions', guid(variables('writerRoleName'), resourceGroup().id))]",
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', guid(variables('writerRoleName'), resourceGroup().id))]",
        "principalId": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName')), '2023-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/runbooks",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('runbookName'))]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"],
      "properties": {
        "description": "TenuVault scheduled Intune backup in Azure",
        "runbookType": "PowerShell72",
        "logProgress": true,
        "logVerbose": false,
        "publishContentLink": {
          "uri": "[parameters('runbookUri')]",
          "version": "1.0.0.0"
        }
      }
    },
    {
      "copy": {
        "name": "automationVariables",
        "count": "[length(variables('variableValues'))]"
      },
      "type": "Microsoft.Automation/automationAccounts/variables",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('variableValues')[copyIndex()].name)]",
      "dependsOn": ["[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"],
      "properties": {
        "value": "[concat('\"', variables('variableValues')[copyIndex()].value, '\"')]",
        "isEncrypted": false
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/schedules",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('scheduleName'))]",
      "dependsOn": ["[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"],
      "properties": {
        "description": "[concat('TenuVault cloud backup for tenant ', parameters('tenantId'))]",
        "startTime": "[parameters('scheduleStartTime')]",
        "expiryTime": "9999-12-31T23:59:59.9999999+00:00",
        "interval": 1,
        "frequency": "[parameters('frequency')]",
        "timeZone": "[parameters('timeZone')]",
        "advancedSchedule": "[if(equals(parameters('frequency'), 'Week'), createObject('weekDays', createArray(parameters('weekDay'))), json('null'))]"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/jobSchedules",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', guid(variables('scheduleName'), variables('runbookName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts/runbooks', parameters('automationAccountName'), variables('runbookName'))]",
        "[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('automationAccountName'), variables('scheduleName'))]"
      ],
      "properties": {
        "runbook": { "name": "[variables('runbookName')]" },
        "schedule": { "name": "[variables('scheduleName')]" },
        "parameters": { "TenantKey": "[variables('tenantKey')]" }
      }
    }
  ],
  "outputs": {
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName')), '2023-11-01', 'full').identity.principalId]",
      "metadata": { "description": "Object (principal) id of the Automation account identity. A Global Administrator assigns it the Graph application roles below." }
    },
    "graphRolesToAssign": {
      "type": "string",
      "value": "DeviceManagementConfiguration.Read.All, DeviceManagementApps.Read.All, DeviceManagementServiceConfig.Read.All, DeviceManagementScripts.Read.All, DeviceManagementRBAC.Read.All (plus DeviceManagementManagedDevices.Read.All only when includeDeviceCategories is true)",
      "metadata": { "description": "Read-only Microsoft Graph application roles for the managed identity. Until they are assigned every run fails with access denied, on purpose." }
    },
    "pasteIntoTenuVault": {
      "type": "string",
      "value": "[concat('tenantId=', parameters('tenantId'), '\nsubscriptionId=', subscription().subscriptionId, '\nresourceGroup=', resourceGroup().name, '\nautomationAccount=', parameters('automationAccountName'), '\nstorageAccount=', parameters('storageAccountName'), '\nkeyVault=', parameters('keyVaultName'), '\nscheduleName=', variables('scheduleName'), '\nfrequency=', if(equals(parameters('frequency'), 'Week'), 'weekly', 'daily'), '\ntime=', substring(parameters('scheduleStartTime'), 11, 5), '\nweekDay=', parameters('weekDay'), '\ntimeZone=', parameters('timeZone'), '\ntenantKey=', variables('tenantKey'), '\nlinked=true')]",
      "metadata": { "description": "Paste this block into TenuVault (Backup and Restore > Schedule > Where backups run > In Azure) so the app can show the cloud runner and its status." }
    }
  }
}
